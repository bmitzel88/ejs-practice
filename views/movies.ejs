<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favorite Movies</title>
</head>
<body>

    <!-- Include partials/header -->
    <%- include('partials/header') %>
    
    <main>
        <h1>Favorite Movies List:</h1>

        <ul>

            <% movies.forEach(movie=> { %>

                <li><%= movie %></li>

            <% }) %>

        

        </ul>
    </main>


    <!-- Include partials/footer -->
    <%- include('partials/footer') %>
</body>
</html>