<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Friends</title>
</head>
<body>
    <!-- Include partials/header -->
    <%- include('partials/header') %>

    <main>
        <h1>Your friends:</h1>

        <ul>

            <% friends.forEach(friend=> { %>

                <li><%= friend %></li>

            <% }) %>

        

        </ul>
    </main>
    <!-- Include partials/footer -->
    <%- include('partials/footer') %>
</body>
</html>